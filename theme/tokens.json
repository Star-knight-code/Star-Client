  "performance": {
    "ram": {
      "min-mb": 512,
      "max-mb": 65536,
      "step-mb": 256,
      "default-min-mb": 1024,
      "default-max-mb": 4096,
      "safe-max-fraction-of-physical": 0.75,
      "warn-below-mb": 2048,
      "warn-above-mb": 12288
    },
    "garbage-collectors": [
      {
        "id": "g1gc",
        "label": "G1GC",
        "summary": "Balanced default. Best compatibility and steady frame pacing on 4-8 GB heaps.",
        "jvm-args": [
          "-XX:+UseG1GC",
          "-XX:+ParallelRefProcEnabled",
          "-XX:MaxGCPauseMillis=200",
          "-XX:+UnlockExperimentalVMOptions",
          "-XX:+DisableExplicitGC",
          "-XX:G1NewSizePercent=30",
          "-XX:G1MaxNewSizePercent=40",
          "-XX:G1HeapRegionSize=8M",
          "-XX:G1ReservePercent=20",
          "-XX:G1HeapWastePercent=5",
          "-XX:G1MixedGCCountTarget=4",
          "-XX:InitiatingHeapOccupancyPercent=15",
          "-XX:G1MixedGCLiveThresholdPercent=90",
          "-XX:G1RSetUpdatingPauseTimePercent=5",
          "-XX:SurvivorRatio=32",
          "-XX:+PerfDisableSharedMem",
          "-XX:MaxTenuringThreshold=1"
        ],
        "requires": {
          "java": ">=8"
        }
      },
      {
        "id": "zgc",
        "label": "ZGC",
        "summary": "Ultra-low pause times. Needs Java 17+ and 8 GB+ of RAM to beat G1GC.",
        "jvm-args": [
          "-XX:+UseZGC",
          "-XX:+UnlockExperimentalVMOptions",
          "-XX:+DisableExplicitGC",
          "-XX:+PerfDisableSharedMem",
          "-XX:ZCollectionInterval=120",
          "-XX:ZAllocationSpikeTolerance=5",
          "-XX:ConcGCThreads=2"
        ],
        "requires": {
          "java": ">=17"
        }
      },
      {
        "id": "zgc-generational",
        "label": "Generational ZGC",
        "summary": "Java 21+ only. Low pauses with better throughput than classic ZGC.",
        "jvm-args": [
          "-XX:+UseZGC",
          "-XX:+ZGenerational",
          "-XX:+UnlockExperimentalVMOptions",
          "-XX:+DisableExplicitGC",
          "-XX:+PerfDisableSharedMem"
        ],
        "requires": {
          "java": ">=21"
        }
      },
      {
        "id": "shenandoah",
        "label": "Shenandoah",
        "summary": "Low-pause alternative to ZGC. Handy when ZGC stutters on small heaps.",
        "jvm-args": [
          "-XX:+UseShenandoahGC",
          "-XX:ShenandoahGCMode=iu",
          "-XX:+UnlockExperimentalVMOptions",
          "-XX:+DisableExplicitGC",
          "-XX:+PerfDisableSharedMem"
        ],
        "requires": {
          "java": ">=12"
        }
      },
      {
        "id": "serial",
        "label": "Serial GC",
        "summary": "Tiny footprint for low-spec machines and very small heaps.",
        "jvm-args": [
          "-XX:+UseSerialGC",
          "-XX:+DisableExplicitGC",
          "-XX:+PerfDisableSharedMem"
        ],
        "requires": {
          "java": ">=8"
        }
      },
      {
        "id": "parallel",
        "label": "Parallel GC",
        "summary": "Highest raw throughput, longer pauses. Good for servers, not for PvP.",
        "jvm-args": [
          "-XX:+UseParallelGC",
          "-XX:ParallelGCThreads=4",
          "-XX:+DisableExplicitGC",
          "-XX:+PerfDisableSharedMem"
        ],
        "requires": {
          "java": ">=8"
        }
      }
    ]
  }
